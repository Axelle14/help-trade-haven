# ServiceSwap environment variables
#
# Vite exposes every variable prefixed with VITE_ to the browser bundle.
# NEVER put database passwords, service-role keys, private API keys,
# signing keys or any server secret in a VITE_ variable.
# All values below are public by design (protected by Row Level Security).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
